# Stripe keys — copy to .env for local use, set in Cloudflare Pages env settings for deploys.

# Secret key for the serverless checkout function (sk_...). Never expose this to the browser.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY

# Publishable key for the client-side embedded checkout (pk_...). Safe to expose in the browser.
# Server-side secret goes in Cloudflare as a Worker secret; this one is read by Vite at build time.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY